msgstr "Omita este item e todos os seus filhos, a menos que este especificador de pacote CollectiveAccess retorne um resultado."

#: ../../app/models/ca_data_exporter_items.php:406
msgid "Omit if not empty"
msgstr "Omitir se não estiver vazio"

#: ../../app/models/ca_data_exporter_items.php:407
msgid "Omit this item and all its children if this CollectiveAccess bundle specifier returns a non-empty result."
msgstr ""
"Omita este item e todos os seus filhos se este especificador de pacote configurável CollectiveAccess retornar um resultado não "
"vazio."

#: ../../app/models/ca_data_exporter_items.php:416
msgid "Omit if no children are present"
msgstr "Omitir se não houver filhos presentes"

#: ../../app/models/ca_data_exporter_items.php:417
